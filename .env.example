# ─── Copy this file to .env and fill in your keys ───────────────────────────
# .env is gitignored. Never paste keys into source files.

# ── Provider selection ────────────────────────────────────────────────────────
# Which model provider to use: claude | openai | ollama
TRILLION_PROVIDER=claude

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI (or OpenRouter) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# For OpenRouter, set this and use an OpenRouter model string:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=anthropic/claude-opus-4

# ── Ollama (local, Raspberry Pi) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Voice V1: Deepgram STT (cloud) + Piper TTS (local, free) ─────────────────
# Wired and working: POST /api/transcribe (STT) and POST /api/tts (TTS).
# Without DEEPGRAM_API_KEY, voice input errors and text chat is unaffected.
# Get a Deepgram key at https://console.deepgram.com/signup (free trial credit)
# DEEPGRAM_API_KEY=...
# TTS runs fully offline via Piper — no API key needed. Voice model is
# downloaded to voices/ (see README/HANDOFF for the download command).
# Only set this if you want a different voice than the default.
# PIPER_VOICE_PATH=voices/en_US-amy-medium.onnx
# Optional: switch TTS provider to ElevenLabs (requires a PAID ElevenLabs
# plan — the free tier blocks all API voice access, premade and custom
# voices alike). Default stays "piper" (local, free, offline) if unset, and
# an unrecognized value here also falls through to Piper silently.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Web search (Brave Search and/or Firecrawl) ───────────────────────────────
# Either key (or both) registers the web_search tool in main chat and enables
# the Software Factory's autonomous opportunity scout.
# Brave: free key at https://api-dashboard.search.brave.com/register (2,000
# queries/month free tier).
# BRAVE_SEARCH_API_KEY=...
# Firecrawl: get a key at https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=...
# Optional: pick a backend explicitly (brave|firecrawl). If unset and both
# keys are present, Firecrawl is used.
# TRILLION_SEARCH_PROVIDER=firecrawl
# Optional: point at a self-hosted Firecrawl instance instead of the managed
# api.firecrawl.dev. Same pattern as OLLAMA_BASE_URL for a local Ollama server.
# FIRECRAWL_BASE_URL=http://localhost:3002

# ── Tier 6: Safety rails (the confirmation gate) ─────────────────────────────
# How aggressively the gate fires: off | smart | manual. Even "off" cannot
# clear the hardline list (agent/safety/risk.py) — those are never auto-run.
# TRILLION_CONFIRMATION_MODE=smart
# How long (seconds) a parked action stays approvable before it expires.
# TRILLION_CONFIRMATION_TTL_SECONDS=900
# The main kill switch. Stops gated actions, background dispatch, and builds;
# conversation and read-only tools keep working. Same as running /pause.
# TRILLION_PAUSED=false
# Where the pending-actions/audit-log database is written (SQLite file).
# TRILLION_SAFETY_DB=safety.db

# ── Tier 4: Memory ────────────────────────────────────────────────────────────
# Markdown facts store — plain text so it's readable/hand-editable directly.
# TRILLION_MEMORY_PATH=memory/facts.md

# ── Tier 2: Notes search (search_notes) ──────────────────────────────────────
# The Aires Ai Brain vault (rclone-mounted — see CLAUDE.md) and the local
# SQLite FTS5 index built from it. search_notes only ever reads the index, so
# queries keep working even if the vault mount is down.
# TRILLION_NOTES_VAULT_PATH=~/AiresAiBrain
# TRILLION_NOTES_INDEX_PATH=memory/notes_index.db

# ── Tier 5: Heartbeat ─────────────────────────────────────────────────────────
# Base tick-loop interval (seconds). Each check has its own cadence below;
# this is just how often the loop wakes up to check what's due.
# HEARTBEAT_INTERVAL_SECONDS=30
# Quiet hours (UTC). Non-critical notices are deferred until QUIET_HOURS_END.
# Set start == end to disable quiet hours entirely.
# QUIET_HOURS_START=22           # 10 PM
# QUIET_HOURS_END=8              # 8 AM

# ── Code Sentinel (GitHub watcher, runs on the heartbeat) ────────────────────
# Requires GITHUB_TOKEN and at least one repo in TRILLION_GITHUB_WATCHED_REPOS
# — empty either one and the Code Sentinel checks self-skip rather than
# registering and failing on every tick.
# Personal access token with repo read scope (Settings > Developer settings >
# Personal access tokens on github.com).
# GITHUB_TOKEN=ghp_...
# GITHUB_USERNAME=your-github-username
# Comma-separated "owner/repo" list to watch, e.g.:
# TRILLION_GITHUB_WATCHED_REPOS=sdswonger/trillion,sdswonger/other-repo
# Cadence (seconds) for CI-failure and hotfix-push checks (fast signals).
# HEARTBEAT_FAST_CADENCE_SECONDS=60
# Cadence (seconds) for stale-PR, dependency-alert, and dormant-repo checks
# (slow signals — no need to poll GitHub every minute for these).
# HEARTBEAT_SLOW_CADENCE_SECONDS=1800

# ── Startup guard against public bind (§1.5) ─────────────────────────────────
# serve.py refuses to start if bound to anything other than loopback unless
# an auth token is set here (agent/security/startup_guard.py). When set, the
# token is also required on every /api/ request as
# "Authorization: Bearer <token>" — see agent/security/auth.py. Note the
# stock index.html does not send that header, so a token will 401 the browser
# UI's own API calls; put a reverse proxy in front for a public bind.
# TRILLION_WEB_HOST=127.0.0.1
# TRILLION_WEB_AUTH_TOKEN=
#
# Rotation overlap (§2.1). Set this to the *outgoing* token for as long as it
# takes to move every caller onto the new one, then clear it. Both values
# authenticate while it's set, so a rotation is a sequence of independent
# steps rather than a flag-day cutover. Leave it empty in the steady state —
# an unset PREV grants nothing, it does not mean "accept anything".
# TRILLION_WEB_AUTH_TOKEN_PREV=
#
# Failed-auth lockout (§1.4) is always on when a token is configured and has
# no env knobs: 10 failures from one address inside 5 minutes locks that
# address out for 15 minutes with a 429 + Retry-After. Keyed on the peer
# address, never X-Forwarded-For — see agent/security/auth.py::client_address
# for why, and for what that costs behind a reverse proxy.

# CSP enforcement (§2.2). Off = report-only, which is where a policy starts.
# Do NOT set this on a guess: run a full session first (chat turn, voice turn,
# every panel), read GET /api/security/csp-violations, widen the policy in
# agent/security/headers.py by what actually got blocked, and only then flip.
# An over-tight enforcing policy breaks the UI in ways that look like
# unrelated bugs. Both headers ship when it's on, so violations stay visible.
# TRILLION_CSP_ENFORCE=false
# Where CSP violation reports are persisted (SQLite file).
# TRILLION_CSP_REPORT_DB=csp_reports.db

# ── Design agent (playbooks/design-subagent.md) ──────────────────────────────
# Off by default. When on, `generate_mockup` spawns the Claude Code CLI to
# install packages, write TSX, and run a Next.js build inside a project under
# TRILLION_SOFTWARE_FACTORY_ROOT. It costs real money per dispatch and is
# gated by the confirmation gate. Requires `claude` on PATH — if it isn't
# there the tools are not registered and a line is logged.
# TRILLION_DESIGN_AGENT=false
# Hard ceilings. The per-dispatch check refuses BEFORE spawning rather than
# truncating a run halfway, which would leave a half-composed screen and a
# half-spent budget. Resets at UTC midnight.
# TRILLION_DESIGN_PER_DISPATCH_USD=5
# TRILLION_DESIGN_DAILY_USD=15
# Model for the composition subprocess; empty = Claude Code's own default.
# TRILLION_DESIGN_COMPOSE_MODEL=
# Where dispatch cost history is written (SQLite file).
# TRILLION_DESIGN_DB=design.db
# Tier 5 image generation. Absent = the generate_image tool is simply not
# registered; the other six tiers work without it. Needs `pip install
# google-genai`. NOTE: image models are not in Gemini's free tier — an
# unbilled key authenticates fine and then rejects every generation with a
# zero quota, which looks like a bug and isn't.
# GEMINI_API_KEY=

# ── Bitcoin mining tracker (playbooks/btc-mining-tracker.md) ─────────────────
# Your Ocean payout address. Empty = the whole feature is off: no heartbeat
# checks, no query_mining tool, no widget. This is financial data — it is
# masked by agent/security/log_redact.py and is never put in a prompt or
# returned by the API.
# TRILLION_MINING_WALLET=
# How many days of 60s snapshots to keep before pruning (payouts are never
# pruned — they're the financial record, and they're tiny).
# TRILLION_MINING_RETENTION_DAYS=30
# Where mining history is written (SQLite file).
# TRILLION_MINING_DB=mining.db

# ── Dependency CVE scanning (§3.4) ───────────────────────────────────────────
# Runs weekly on the heartbeat via pip-audit; also triggerable via
# POST /api/security/cve-scan. Where scan history is written (SQLite file).
# TRILLION_CVE_SCAN_DB=cve_scans.db

# ── Cost dashboard ────────────────────────────────────────────────────────────
# Where the local usage/cost database is written (SQLite file).
# TRILLION_USAGE_DB=usage.db
# Port the web server (serve.py) listens on.
# TRILLION_WEB_PORT=8123
# Soft monthly budget in USD. When set, the cost indicator turns amber at 80%
# and red at 100%. Leave unset to disable the budget alert. (It's an alert, not
# a hard cap — spending is never blocked.)
# TRILLION_MONTHLY_BUDGET_USD=50

# ── Software Factory: autonomous builds ──────────────────────────────────────
# Build output root (path-jailed). Defaults to generated-projects/.
# TRILLION_SOFTWARE_FACTORY_ROOT=generated-projects
# Hard cap on builds started per day (on-demand + autonomous combined).
# TRILLION_FACTORY_DAILY_BUILD_CAP=3
# Hard $ cap on same-day spend; a build step refuses to proceed once hit.
# Leave unset to skip this check (daily build cap still applies).
# TRILLION_FACTORY_DAILY_BUDGET_USD=10
# Kill switch — set to 1/true to stop new builds (on-demand and autonomous)
# without restarting the process.
# TRILLION_FACTORY_PAUSED=0
# Comma-separated themes the autonomous scheduler may propose builds within.
# Leave unset/empty to keep self-initiated building off (on-demand /build is
# unaffected either way).
# TRILLION_FACTORY_AUTONOMOUS_THEMES=small internal utilities
# How often the autonomous scheduler proposes and starts a new build.
# TRILLION_FACTORY_AUTONOMOUS_INTERVAL_HOURS=24
