# ─── Copy this file to .env and fill in your keys ───────────────────────────
# .env is gitignored. Never paste keys into source files.

# ── Provider selection ────────────────────────────────────────────────────────
# Which model provider to use: claude | openai | ollama
TRILLION_PROVIDER=claude

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-4-8 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI (or OpenRouter) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
# For OpenRouter, set this and use an OpenRouter model string:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=anthropic/claude-opus-4

# ── Ollama (local, Raspberry Pi) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Voice V1: Deepgram STT (cloud) + Piper TTS (local, free) ─────────────────
# Wired and working: POST /api/transcribe (STT) and POST /api/tts (TTS).
# Without DEEPGRAM_API_KEY, voice input errors and text chat is unaffected.
# Get a Deepgram key at https://console.deepgram.com/signup (free trial credit)
# DEEPGRAM_API_KEY=...
# TTS runs fully offline via Piper — no API key needed. Voice model is
# downloaded to voices/ (see README/HANDOFF for the download command).
# Only set this if you want a different voice than the default.
# PIPER_VOICE_PATH=voices/en_US-amy-medium.onnx

# ── Web search (Brave Search and/or Firecrawl) ───────────────────────────────
# Either key (or both) registers the web_search tool in main chat and enables
# the Software Factory's autonomous opportunity scout.
# Brave: free key at https://api-dashboard.search.brave.com/register (2,000
# queries/month free tier).
# BRAVE_SEARCH_API_KEY=...
# Firecrawl: get a key at https://www.firecrawl.dev/
# FIRECRAWL_API_KEY=...
# Optional: pick a backend explicitly (brave|firecrawl). If unset and both
# keys are present, Firecrawl is used.
# TRILLION_SEARCH_PROVIDER=firecrawl
# Optional: point at a self-hosted Firecrawl instance instead of the managed
# api.firecrawl.dev. Same pattern as OLLAMA_BASE_URL for a local Ollama server.
# FIRECRAWL_BASE_URL=http://localhost:3002

# ── Tier 6: Safety rails (the confirmation gate) ─────────────────────────────
# How aggressively the gate fires: off | smart | manual. Even "off" cannot
# clear the hardline list (agent/safety/risk.py) — those are never auto-run.
# TRILLION_CONFIRMATION_MODE=smart
# How long (seconds) a parked action stays approvable before it expires.
# TRILLION_CONFIRMATION_TTL_SECONDS=900
# The main kill switch. Stops gated actions, background dispatch, and builds;
# conversation and read-only tools keep working. Same as running /pause.
# TRILLION_PAUSED=false
# Where the pending-actions/audit-log database is written (SQLite file).
# TRILLION_SAFETY_DB=safety.db

# ── Tier 4: Memory ────────────────────────────────────────────────────────────
# Markdown facts store — plain text so it's readable/hand-editable directly.
# TRILLION_MEMORY_PATH=memory/facts.md

# ── Tier 2: Notes search (search_notes) ──────────────────────────────────────
# The Aires Ai Brain vault (rclone-mounted — see CLAUDE.md) and the local
# SQLite FTS5 index built from it. search_notes only ever reads the index, so
# queries keep working even if the vault mount is down.
# TRILLION_NOTES_VAULT_PATH=~/AiresAiBrain
# TRILLION_NOTES_INDEX_PATH=memory/notes_index.db

# ── Tier 5: Heartbeat ─────────────────────────────────────────────────────────
# Base tick-loop interval (seconds). Each check has its own cadence below;
# this is just how often the loop wakes up to check what's due.
# HEARTBEAT_INTERVAL_SECONDS=30
# Quiet hours (UTC). Non-critical notices are deferred until QUIET_HOURS_END.
# Set start == end to disable quiet hours entirely.
# QUIET_HOURS_START=22           # 10 PM
# QUIET_HOURS_END=8              # 8 AM

# ── Code Sentinel (GitHub watcher, runs on the heartbeat) ────────────────────
# Requires GITHUB_TOKEN and at least one repo in TRILLION_GITHUB_WATCHED_REPOS
# — empty either one and the Code Sentinel checks self-skip rather than
# registering and failing on every tick.
# Personal access token with repo read scope (Settings > Developer settings >
# Personal access tokens on github.com).
# GITHUB_TOKEN=ghp_...
# GITHUB_USERNAME=your-github-username
# Comma-separated "owner/repo" list to watch, e.g.:
# TRILLION_GITHUB_WATCHED_REPOS=sdswonger/trillion,sdswonger/other-repo
# Cadence (seconds) for CI-failure and hotfix-push checks (fast signals).
# HEARTBEAT_FAST_CADENCE_SECONDS=60
# Cadence (seconds) for stale-PR, dependency-alert, and dormant-repo checks
# (slow signals — no need to poll GitHub every minute for these).
# HEARTBEAT_SLOW_CADENCE_SECONDS=1800

# ── Startup guard against public bind (§1.5) ─────────────────────────────────
# serve.py refuses to start if bound to anything other than loopback unless
# an auth token is set here — there is no bearer-auth middleware yet, so this
# only proves the non-loopback bind was deliberate. See
# agent/security/startup_guard.py.
# TRILLION_WEB_HOST=127.0.0.1
# TRILLION_WEB_AUTH_TOKEN=

# ── Dependency CVE scanning (§3.4) ───────────────────────────────────────────
# Runs weekly on the heartbeat via pip-audit; also triggerable via
# POST /api/security/cve-scan. Where scan history is written (SQLite file).
# TRILLION_CVE_SCAN_DB=cve_scans.db

# ── Cost dashboard ────────────────────────────────────────────────────────────
# Where the local usage/cost database is written (SQLite file).
# TRILLION_USAGE_DB=usage.db
# Port the web server (serve.py) listens on.
# TRILLION_WEB_PORT=8123
# Soft monthly budget in USD. When set, the cost indicator turns amber at 80%
# and red at 100%. Leave unset to disable the budget alert. (It's an alert, not
# a hard cap — spending is never blocked.)
# TRILLION_MONTHLY_BUDGET_USD=50
