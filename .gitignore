# Secrets — never commit these
.env
*.env
secrets.yml
secrets.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
env/
dist/
build/
# ...but NOT the vendored Three.js build. The bare `build/` above matches
# vendor/three/build/ too, which silently kept three.module.js out of every
# commit — so the import map's "three" specifier 404'd and the whole 3D
# scene failed to initialise in a fresh clone. Vendoring exists precisely so
# the UI works offline and the CSP needs no third-party script-src; a
# vendored file that was never committed does neither.
!vendor/three/build/
*.egg-info/
.eggs/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~

# Trillion runtime state (not secrets, but not code)
# These live in data/ and are persisted locally — commit if you want to back them up
# data/memory.json
# data/schedule.json
# data/log.jsonl

# Cost-tracking database (local usage rows; commit if you want to back it up)
usage.db
*.db

# Audio temp files
*.wav
*.mp3
*.ogg
/tmp/

# Software Factory build output — generated projects, not source
generated-projects/

# Piper voice models (large binary downloads, not source — see HANDOFF.md
# for the download command)
voices/*.onnx
voices/*.onnx.json
csp_reports.db
mining.db
design.db

# Board of advisors, cross-machine queue, revenue celebration (all SQLite —
# *.db above already covers them, listed for discoverability).
board.db
remote.db
revenue.db

# The desktop app's own virtualenv and build output.
desktop/.venv/
desktop/dist/
